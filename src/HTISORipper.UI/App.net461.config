<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- Compatibility build for Windows 8.0. Runs on any .NET Framework 4.6.1 or later.
         Per-monitor DPI (WinForms 4.7+) is unavailable; the app is system-DPI aware via the manifest. -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
</configuration>
