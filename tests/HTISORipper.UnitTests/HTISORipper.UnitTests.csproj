<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- net462 runs the tests against the net461 libraries (Microsoft.NET.Test.Sdk needs 4.6.2+); net48 against the main build. -->
    <TargetFrameworks>net462;net48</TargetFrameworks>
    <RootNamespace>HTISORipper.UnitTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HTISORipper.Core\HTISORipper.Core.csproj" />
    <ProjectReference Include="..\..\src\HTISORipper.Logging\HTISORipper.Logging.csproj" />
    <ProjectReference Include="..\..\src\HTISORipper.DiscEngine\HTISORipper.DiscEngine.csproj" />
    <ProjectReference Include="..\..\src\HTISORipper.Imaging\HTISORipper.Imaging.csproj" />
    <ProjectReference Include="..\..\src\HTISORipper.Verification\HTISORipper.Verification.csproj" />
    <ProjectReference Include="..\..\src\HTISORipper.UI\HTISORipper.UI.csproj" />
  </ItemGroup>
</Project>
